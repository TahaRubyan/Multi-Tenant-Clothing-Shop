# Test-only fixture. Loaded automatically by Vite/Vitest when running the
# test suite (mode=test) — never used by `vite build` or `vite dev`.
#
# Provides the master-admin bootstrap password the integration tests log in
# with. Production/dev builds ship with NO default value for this variable;
# set VITE_MASTER_ADMIN_PASSWORD explicitly in your own untracked .env if you
# want the same offline bootstrap capability on a real deployment.
VITE_MASTER_ADMIN_PASSWORD=Admin123
